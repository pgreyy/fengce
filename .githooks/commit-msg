#!/bin/sh
# Rejects commit messages that carry attribution lines.
msg_file="$1"
if grep -v '^#' "$msg_file" | grep -qiE 'co-authored-by|claude|anthropic|generated with|noreply@anthropic\.com'; then
  echo "commit-msg: rejected, message contains an attribution line or a blocked word." >&2
  grep -v '^#' "$msg_file" | grep -niE 'co-authored-by|claude|anthropic|generated with|noreply@anthropic\.com' >&2
  exit 1
fi
exit 0
