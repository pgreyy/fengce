{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "es2022",
      "dom"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@fengce/sdk": [
        "../sdk/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.mts",
    "demo/**/*.mts"
  ]
}
