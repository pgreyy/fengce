{
  "name": "@fengce/sdk",
  "version": "0.1.1",
  "description": "TypeScript SDK for Fengce: TapeOut circuit schemas, Quote certificates and Safe guard install calldata",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "fengce-quote": "dist/cli/quote.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pgreyy/fengce.git",
    "directory": "sdk"
  },
  "keywords": [
    "tapeout",
    "x-layer",
    "safe",
    "guard",
    "policy",
    "circuit"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "quote": "tsx src/cli/quote.ts",
    "sync-artifacts": "tsx scripts/sync-artifacts.ts",
    "prepack": "npm run build && cp ../LICENSE ./LICENSE",
    "test:live": "tsx scripts/differential.ts"
  },
  "dependencies": {
    "viem": "^2.58.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
